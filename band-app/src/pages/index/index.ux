<template>
  <div class="page">
    <swiper class="page-swiper" indicator="true" vertical="true" loop="false" enableswipe="true">
      <div class="overview-page">
        <text class="clock-time">{{clockTimeText}}</text>
        <div class="sync-pill sync-pill-{{statusTone}}">
          <text class="status-label">{{statusText}}</text>
          <text class="status-time" if="{{statusTimeText}}">{{statusTimeText}}</text>
        </div>
        <div class="quota-section">
          <text class="section-label">5小时额度</text>
          <div class="quota-value">
            <text class="quota-number quota-number-{{fiveHourNumberSize}} text-tone-{{fiveHourTone}}">{{fiveHourNumberText}}</text>
            <text class="quota-unit text-tone-{{fiveHourTone}}">{{fiveHourUnitText}}</text>
          </div>
          <text class="section-detail">{{fiveHourResetText}}</text>
        </div>
        <div class="divider"></div>
        <div class="weekly-section">
          <div class="weekly-heading">
            <text class="weekly-label">周额度</text>
            <text class="weekly-percent text-tone-{{quotaTone}}">{{quotaRemainingText}}</text>
          </div>
          <progress class="weekly-progress weekly-progress-{{quotaTone}}" type="horizontal" percent="{{weeklyProgressPercent}}"></progress>
          <text class="weekly-reset">{{quotaResetText}}</text>
        </div>
        <div class="divider-secondary"></div>
        <div class="reset-section">
          <div class="reset-row">
            <text class="reset-label">可用重置</text>
            <text class="reset-number text-tone-{{resetTone}}">{{resetCountText}}</text>
            <text class="reset-unit text-tone-{{resetTone}}">次</text>
          </div>
          <text class="reset-expiry">{{resetExpiryText}}</text>
        </div>
      </div>

      <div class="tasks-page">
        <text class="clock-time">{{clockTimeText}}</text>
        <div class="sync-pill sync-pill-{{statusTone}}">
          <text class="status-label">{{statusText}}</text>
          <text class="status-time" if="{{statusTimeText}}">{{statusTimeText}}</text>
        </div>
        <div class="task-section">
          <text class="task-empty" if="{{!hasTaskItems}}">{{taskSummaryText}}</text>
          <div class="task-item" for="{{taskItems}}">
            <div class="task-dot task-dot-{{$item.tone}}"></div>
            <text class="task-title">{{$item.title}}</text>
            <div class="task-meta">
              <text class="task-status">{{$item.statusText}}</text>
              <text class="task-time">{{$item.timeText}}</text>
            </div>
            <div class="task-divider" if="{{$item.showDivider}}"></div>
          </div>
        </div>
      </div>
    </swiper>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'
import storage from '@system.storage'
import quotaState from '../../common/quota-state.cjs'
import taskState from '../../common/task-state.cjs'

const { createBandView, errorStatusText, formatClock, formatElapsedAge, sanitizeSnapshotForBand } = quotaState
const { createTaskView, sanitizeTaskSnapshotForBand } = taskState
const CACHE_KEY = 'codex-quota-snapshot-v1'
const TASK_CACHE_KEY = 'codex-task-snapshot-v1'
const REFRESH_INTERVAL = 5000
const REQUEST_TIMEOUT = 5000
const FRESH_SYNC_MAX_AGE = 120000
const connection = interconnect.instance()
const STATUS_ALIASES = { '手机链路断开': '离线', '手机链路异常': '离线', '等待手机链路': '离线', '链路状态异常': '离线', '电脑未连接': '离线', '局域网不可用': '离线', '同步超时': '离线', '发送失败': '离线', '显示缓存': '缓存', '缓存不可用': '缓存异常', '缓存读取失败': '缓存异常', '额度格式异常': '数据异常' }

function parseMessage(event) { const raw = event && event.data !== undefined ? event.data : event; if (typeof raw === 'string') { try { return JSON.parse(raw) } catch (error) { return { type: 'invalid' } } } return raw || {} }
function splitQuotaText(value) { const match = String(value || '').match(/^(\d{1,3})(%)$/); return match ? { numberText: match[1], unitText: match[2] } : { numberText: String(value || '--'), unitText: '' } }
function showsRelativeAge(statusText) { return statusText === '缓存' || statusText === '离线' }

export default {
  private: { statusText: '读取中', statusTimeText: '', statusTone: 'warning', snapshotStatusText: '', snapshotStatusTone: 'warning', lastSnapshotAtMs: 0, syncFreshnessTimer: null, hasSnapshot: false, quotaRemainingText: '--', quotaResetText: '暂无额度数据', quotaTone: 'unknown', weeklyProgressPercent: 0, fiveHourNumberText: '--', fiveHourUnitText: '', fiveHourNumberSize: 'regular', fiveHourResetText: '暂无数据', fiveHourTone: 'unknown', resetCountText: '--', resetTone: 'unknown', resetExpiryText: '暂无重置数据', taskSummaryText: '任务状态不可用', hasTaskItems: false, taskItems: [], taskSnapshot: null, clockTimeText: '--:--', connected: false, visible: false, refreshing: false, requestNonce: '', refreshTimer: null, timeoutTimer: null, clockTimer: null },
  onInit() {
    connection.onopen = () => { this.connected = true; if (this.visible) this.requestSnapshot() }
    connection.onclose = () => { this.connected = false; this.finishRequest(); this.showCachedStatus('手机链路断开') }
    connection.onerror = (error) => { this.connected = false; this.finishRequest(); this.showCachedStatus(error && error.code === 1001 ? '需重新授权' : '手机链路异常') }
    connection.onmessage = (event) => this.handleMessage(parseMessage(event))
    this.updateClock(); this.loadCache(); this.loadTaskCache()
  },
  onShow() {
    this.visible = true; this.startClockTimer(); this.updateSyncFreshness(); this.scheduleSyncFreshness()
    connection.getReadyState({ success: (result) => { this.connected = result.status === 1; if (this.connected) this.requestSnapshot(); else this.showCachedStatus('等待手机链路') }, fail: () => { this.connected = false; this.showCachedStatus('链路状态异常') } })
    this.startRefreshTimer()
  },
  onHide() { this.visible = false; this.stopRefreshTimer(); this.stopClockTimer(); this.stopSyncFreshnessTimer(); this.finishRequest() },
  onDestroy() { this.stopRefreshTimer(); this.stopClockTimer(); this.stopSyncFreshnessTimer(); this.finishRequest(); connection.onopen = null; connection.onclose = null; connection.onerror = null; connection.onmessage = null },
  updateClock() { this.clockTimeText = formatClock(new Date()).timeText; this.updateSyncFreshness(); if (this.taskSnapshot) this.applyTaskSnapshot(this.taskSnapshot) },
  startClockTimer() { this.stopClockTimer(); this.updateClock(); const delay = 60050 - (Date.now() % 60000); this.clockTimer = setTimeout(() => { this.clockTimer = null; if (this.visible) this.startClockTimer() }, delay) },
  stopClockTimer() { if (this.clockTimer) clearTimeout(this.clockTimer); this.clockTimer = null },
  loadCache() { storage.get({ key: CACHE_KEY, default: '', success: (value) => { if (!value) return; try { const snapshot = sanitizeSnapshotForBand(JSON.parse(value), new Date()); this.applySnapshot(snapshot); this.showCachedStatus('显示缓存', 'warning') } catch (error) { this.showCachedStatus('缓存不可用') } }, fail: () => this.showCachedStatus('缓存读取失败') }) },
  loadTaskCache() { storage.get({ key: TASK_CACHE_KEY, default: '', success: (value) => { if (!value) return; try { this.applyTaskSnapshot(sanitizeTaskSnapshotForBand(JSON.parse(value))) } catch (error) { this.applyTaskSnapshot(null) } }, fail: () => this.applyTaskSnapshot(null) }) },
  startRefreshTimer() { this.stopRefreshTimer(); this.refreshTimer = setInterval(() => { if (this.visible && this.connected) this.requestSnapshot() }, REFRESH_INTERVAL) },
  stopRefreshTimer() { if (this.refreshTimer) clearInterval(this.refreshTimer); this.refreshTimer = null },
  requestSnapshot() { if (this.refreshing || !this.connected) return; this.refreshing = true; this.requestNonce = `band-${Date.now()}`; const nonce = this.requestNonce; if (!this.hasSnapshot) { this.statusText = '同步中'; this.statusTone = 'warning'; this.statusTimeText = '' } connection.send({ data: { type: 'quota_request', nonce }, success: () => { this.timeoutTimer = setTimeout(() => { if (this.refreshing && this.requestNonce === nonce) { this.finishRequest(); this.showCachedStatus('同步超时') } }, REQUEST_TIMEOUT) }, fail: () => { this.finishRequest(); this.showCachedStatus('发送失败') } }) },
  finishRequest() { if (this.timeoutTimer) clearTimeout(this.timeoutTimer); this.timeoutTimer = null; this.refreshing = false },
  handleMessage(message) {
    if (!message || message.nonce !== this.requestNonce) return
    this.finishRequest()
    if (Object.prototype.hasOwnProperty.call(message, 'taskSnapshot')) { if (message.taskSnapshot === null) { this.applyTaskSnapshot(null); storage.set({ key: TASK_CACHE_KEY, value: '' }) } else { try { const taskSnapshot = sanitizeTaskSnapshotForBand(message.taskSnapshot); this.applyTaskSnapshot(taskSnapshot); storage.set({ key: TASK_CACHE_KEY, value: JSON.stringify(taskSnapshot) }) } catch (error) { this.taskSnapshot = null; this.taskSummaryText = '任务数据异常'; this.hasTaskItems = false; this.taskItems = [] } } }
    if (message.type === 'quota_error') { this.showCachedStatus(errorStatusText(message.code)); return }
    if (message.type !== 'quota_snapshot') return
    try { const snapshot = sanitizeSnapshotForBand(message.snapshot, new Date()); this.applySnapshot(snapshot); storage.set({ key: CACHE_KEY, value: JSON.stringify(snapshot) }) } catch (error) { this.showCachedStatus('额度格式异常') }
  },
  showCachedStatus(text, tone = 'danger') { this.stopSyncFreshnessTimer(); this.statusText = STATUS_ALIASES[text] || text; this.statusTone = tone; const age = Math.max(0, Date.now() - this.lastSnapshotAtMs); this.statusTimeText = showsRelativeAge(this.statusText) && this.lastSnapshotAtMs ? formatElapsedAge(age) : '' },
  updateSyncFreshness() { if (!this.hasSnapshot) return; const age = Math.max(0, Date.now() - this.lastSnapshotAtMs); if (this.snapshotStatusText === '已同步' && this.snapshotStatusTone === 'healthy') { if (age > FRESH_SYNC_MAX_AGE) { this.statusText = '缓存'; this.statusTone = 'warning'; this.statusTimeText = formatElapsedAge(age) } else { this.statusText = '已同步'; this.statusTone = 'healthy'; this.statusTimeText = '' } return } this.statusText = this.snapshotStatusText; this.statusTone = this.snapshotStatusTone; this.statusTimeText = showsRelativeAge(this.snapshotStatusText) ? formatElapsedAge(age) : '' },
  scheduleSyncFreshness() { this.stopSyncFreshnessTimer(); if (!this.visible || !this.hasSnapshot || this.snapshotStatusText !== '已同步' || this.snapshotStatusTone !== 'healthy') return; const age = Math.max(0, Date.now() - this.lastSnapshotAtMs); const nextAge = age < FRESH_SYNC_MAX_AGE ? FRESH_SYNC_MAX_AGE + 1 : (Math.floor(age / FRESH_SYNC_MAX_AGE) + 1) * FRESH_SYNC_MAX_AGE + 1; this.syncFreshnessTimer = setTimeout(() => { this.syncFreshnessTimer = null; this.updateSyncFreshness(); this.scheduleSyncFreshness() }, Math.max(1, nextAge - age)) },
  stopSyncFreshnessTimer() { if (this.syncFreshnessTimer) clearTimeout(this.syncFreshnessTimer); this.syncFreshnessTimer = null },
  applySnapshot(snapshot) { const view = createBandView(snapshot, new Date()); const fiveHour = splitQuotaText(view.fiveHourRemainingText); this.snapshotStatusText = view.statusText; this.snapshotStatusTone = view.statusTone; this.lastSnapshotAtMs = Date.parse(snapshot.generatedAt); this.hasSnapshot = true; this.updateSyncFreshness(); this.scheduleSyncFreshness(); this.quotaRemainingText = view.quotaRemainingText; this.quotaResetText = view.quotaResetText; this.quotaTone = view.quotaTone; this.weeklyProgressPercent = view.weeklyProgressPercent; this.fiveHourNumberText = fiveHour.numberText; this.fiveHourUnitText = fiveHour.unitText; this.fiveHourNumberSize = fiveHour.numberText.length > 2 ? 'compact' : 'regular'; this.fiveHourResetText = view.fiveHourResetText; this.fiveHourTone = view.fiveHourTone; this.resetCountText = view.resetCountText; this.resetTone = view.resetTone; this.resetExpiryText = view.resetExpiryText },
  applyTaskSnapshot(snapshot) { this.taskSnapshot = snapshot; const view = createTaskView(snapshot, new Date()); this.taskSummaryText = view.summaryText; this.hasTaskItems = view.items.length > 0; this.taskItems = view.items }
}
</script>

<style>
.page,.page-swiper,.overview-page,.tasks-page { width:212px;height:520px;background-color:#0d1012; }
.overview-page,.tasks-page { position:relative; }
.page-swiper { indicator-size:7px; indicator-color:#526167; indicator-selected-color:#f7f8f9; indicator-right:10px; indicator-top:249px; }
.clock-time { position:absolute;top:2px;left:20px;width:172px;height:28px;color:#f7f8f9;font-size:24px;font-weight:bold;line-height:28px;text-align:center; }
.sync-pill { position:absolute;top:41px;left:48px;width:116px;height:36px;border-width:1px;border-style:solid;border-radius:18px;flex-direction:row;justify-content:center;align-items:center; }
.sync-pill-healthy { background-color:#0b2a25;border-color:#278f76; }.sync-pill-warning { background-color:#382c13;border-color:#a7832a; }.sync-pill-danger { background-color:#3a191b;border-color:#c75e50; }
.status-label,.status-time { color:#f4fbf8;font-size:16px;font-weight:bold; }.status-time { margin-left:7px; }
.quota-section { position:absolute;top:110px;left:16px;width:180px;flex-direction:column;align-items:center; }.section-label { width:180px;height:24px;color:#f7f8f9;font-size:20px;font-weight:bold;text-align:center; }.quota-value { width:180px;height:102px;margin-top:2px;margin-left:4px;flex-direction:row;justify-content:center;align-items:flex-end; }.quota-number { height:102px;font-size:96px;font-weight:bold;line-height:102px;text-align:center; }.quota-number-compact { font-size:80px; }.quota-unit { margin-left:4px;margin-bottom:8px;font-size:34px;font-weight:bold; }.section-detail { width:180px;height:24px;color:#b7c1c4;font-size:20px;text-align:center; }.text-tone-healthy { color:#59ddb8; }.text-tone-warning { color:#ffd05e; }.text-tone-danger { color:#ff7e7e; }.text-tone-offline,.text-tone-unknown { color:#b5bec1; }
.divider { position:absolute;top:280px;left:20px;width:172px;height:1px;background-color:#354248; }.weekly-section { position:absolute;top:297px;left:20px;width:172px;flex-direction:column; }.weekly-heading { width:172px;height:24px;flex-direction:row;justify-content:space-between;align-items:center; }.weekly-label { width:100px;height:24px;color:#f7f8f9;font-size:20px;font-weight:bold; }.weekly-percent { width:72px;height:24px;font-size:22px;font-weight:bold;text-align:right; }.weekly-progress { width:172px;height:8px;margin-top:11px;layer-color:#354248;stroke-width:8px; }.weekly-progress-healthy { color:#59ddb8; }.weekly-progress-warning { color:#ffd05e; }.weekly-progress-danger { color:#ff7e7e; }.weekly-progress-offline,.weekly-progress-unknown { color:#b5bec1; }.weekly-reset { width:172px;height:20px;margin-top:10px;color:#b7c1c4;font-size:15px;text-align:left; }
.divider-secondary { position:absolute;top:387px;left:20px;width:172px;height:1px;background-color:#354248; }.reset-section { position:absolute;top:405px;left:20px;width:172px;flex-direction:column; }.reset-row { width:172px;height:24px;flex-direction:row;align-items:center; }.reset-label { width:112px;height:24px;color:#f7f8f9;font-size:20px;font-weight:bold; }.reset-number { width:38px;height:24px;font-size:22px;font-weight:bold;text-align:right; }.reset-unit { width:22px;height:24px;margin-left:0;font-size:22px;font-weight:bold;text-align:right; }.reset-expiry { width:172px;height:20px;margin-top:10px;color:#b7c1c4;font-size:15px;text-align:left; }
.task-section { position:absolute;top:115px;left:20px;width:172px;flex-direction:column;align-items:center; }.task-empty { width:172px;height:22px;color:#b7c1c4;font-size:18px;text-align:center; }.task-item { position:relative;width:172px;height:86px;flex-direction:column; }.task-dot { position:absolute;top:19px;left:0;width:7px;height:7px;border-radius:4px;background-color:#b5bec1; }.task-dot-running { background-color:#59aaf2; }.task-dot-waiting { background-color:#67ce91; }.task-dot-danger { background-color:#ff7e7e; }.task-title { width:156px;height:40px;margin-top:7px;margin-left:16px;color:#f7f8f9;font-size:20px;font-weight:bold;line-height:21px;lines:1;text-overflow:ellipsis; }.task-meta { width:140px;height:20px;margin-top:4px;margin-left:16px;flex-direction:row;align-items:center; }.task-status { width:100px;height:20px;color:#9da8ac;font-size:17px;font-weight:bold; }.task-time { width:40px;height:20px;color:#9da8ac;font-size:17px;font-weight:bold;text-align:right; }.task-divider { width:172px;height:1px;margin-top:4px;background-color:#2c373c; }
</style>
